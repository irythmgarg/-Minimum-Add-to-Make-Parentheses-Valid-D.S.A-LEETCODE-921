class Solution {
public:
    int minAddToMakeValid(string s) {
        int open = 0;  // Tracks unmatched '('
        int ans = 0;   // Tracks unmatched ')'

        // Traverse the input string
        for (int i = 0; i < s.length(); i++) {
            if (s[i] == '(') {
                open++;  // Increment unmatched '(' count
            } else if (s[i] == ')') {
                if (open > 0) {
                    open--;  // Match ')' with an unmatched '('
                } else {
                    ans++;  // Increment unmatched ')' count
                }
            }
        }

        // Add remaining unmatched '(' to the result
        return ans + open;
    }
};
